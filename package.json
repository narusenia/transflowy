{
  "name": "transflowy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CGO_ENABLED=1 mygo dev",
    "build": "CGO_ENABLED=1 mygo build",
    "generate": "CGO_ENABLED=1 mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "cert": "sh scripts/create-signing-cert.sh",
    "build:signed": "CGO_ENABLED=1 mygo build -sign \"transflowy Local Signing\" -skip-dmg"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "mygo-runtime": "^0.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^8.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "mygo-cli": "^0.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^8"
  }
}
